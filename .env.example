# Course administrator access and signed sessions
# Set a long, private password before launch. Comma-separated extra admin passwords are optional.
COURSE_PASSWORD=
COURSE_PASSWORDS=
ACCESS_SECRET=
PORT=3000

# Tribute purchase verification (purchases and checkout remain entirely in Tribute)
# TRIBUTE_API_KEY verifies Tribute's trbt-signature webhook header.
TRIBUTE_API_KEY=
# Copy the matching identifiers from your Tribute product/subscription dashboard.
TRIBUTE_PRODUCT_ID=
TRIBUTE_SUBSCRIPTION_ID=
TRIBUTE_PRODUCT_TITLE=Contemporary Horeca Scene · 2026 Edition
# Optional fallback amounts only; signed webhook amounts take precedence.
TRIBUTE_PRICE=
TRIBUTE_PRODUCT_PRICE=
TRIBUTE_SUBSCRIPTION_PRICE=

# Telegram Access Bot and Admin Bot (the same bot)
BOT_TOKEN=
BOT_USERNAME=
ADMIN_IDS=
# Public HTTPS course origin used only for private, single-use registration links.
COURSE_URL=
