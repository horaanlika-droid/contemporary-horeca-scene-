# Course administrator access and signed sessions
# Set a long, private password before launch. Comma-separated extra admin passwords are optional.
COURSE_PASSWORD=
COURSE_PASSWORDS=
ACCESS_SECRET=
PORT=3000

# Tribute purchase verification (purchases and checkout remain entirely in Tribute)
# TRIBUTE_API_KEY verifies Tribute's trbt-signature webhook header.
TRIBUTE_API_KEY=
# Copy the matching identifiers from your Tribute product/subscription dashboard.
TRIBUTE_PRODUCT_ID=
TRIBUTE_SUBSCRIPTION_ID=
TRIBUTE_PRODUCT_TITLE=Contemporary Horeca Scene · 2026 Edition
# Optional fallback amounts only; signed webhook amounts take precedence.
TRIBUTE_PRICE=
TRIBUTE_PRODUCT_PRICE=
TRIBUTE_SUBSCRIPTION_PRICE=
# Public purchase link shown in the app when access is not yet purchased.
# If set, the sign-in screen shows a hyperlink:
#   "No login yet? Get access on Tribute — after payment the bot will send your login and password automatically."
# Example: https://t.me/tribute/app?startapp=pXXXX  or your Tribute channel/product link (must be https://)
# This is NOT used for webhook verification; checkout itself stays in Tribute.
TRIBUTE_PRODUCT_URL=
# Alternative env names accepted for the same link (first non-empty wins):
# TRIBUTE_PURCHASE_URL, TRIBUTE_PAYMENT_URL, TRIBUTE_CHECKOUT_URL
# Optional auto-issue mode: when set to "true", a verified Tribute payment immediately
# generates a login+password and sends it via the bot without manual /admit.
# Leave empty/false to keep manual admission (admin verifies payment then runs /admit or /issue).
# Existing tests and the current manual-approval flow expect manual mode.
AUTO_CREDENTIALS=
TRIBUTE_AUTO_CREDENTIALS=

# Telegram Access Bot and Admin Bot (the same bot)
BOT_TOKEN=
BOT_USERNAME=
ADMIN_IDS=
# Public HTTPS course origin used for the shared registration page and course links.
# Example: https://your-domain.example
COURSE_URL=
