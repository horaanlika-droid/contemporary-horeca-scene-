# Course administrator access and signed sessions
# Set a long, private password before launch. Comma-separated extra admin passwords are optional.
COURSE_PASSWORD=
COURSE_PASSWORDS=
ACCESS_SECRET=
PORT=3000

# Tribute digital product / subscription
# TRIBUTE_API_KEY is used only to verify Tribute's trbt-signature webhook header.
TRIBUTE_API_KEY=
# Configure one or both entitlement types. Product purchases grant lasting access;
# subscription events extend access through Tribute's verified expires_at date.
TRIBUTE_PRODUCT_ID=
TRIBUTE_SUBSCRIPTION_ID=
TRIBUTE_PRODUCT_TITLE=Contemporary Horeca Scene · 2026 Edition
TRIBUTE_PRICE=
TRIBUTE_PRODUCT_PRICE=
TRIBUTE_SUBSCRIPTION_PRICE=
# Paste the real HTTPS links from Tribute. The subscription URL is required when both IDs are set.
# Example product: https://t.me/tribute/app?startapp=p123
# Example subscription: https://t.me/tribute/app?startapp=s123
TRIBUTE_PRODUCT_URL=
TRIBUTE_SUBSCRIPTION_URL=

# Telegram Access Bot and Admin Bot (the same bot)
BOT_TOKEN=
BOT_USERNAME=
ADMIN_IDS=
# Optional HTTPS website URL included with the delivered password
COURSE_URL=
